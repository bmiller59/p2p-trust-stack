  "vectors": [
    {
      "id": "VRC-ISS-001",
      "title": "a credential delivered inside an accepted exchange is stored and receipted with the digest of the stored credential",
      "tier": 1,
      "spec": [
        "specs/vrc/relationships/issue/0.1/spec.md:98-109 (issuing party items 1-3, receiving party items 1-3)",
        "specs/vrc/relationships/issue/0.1/spec.md:83-89 (receipt names the stored artifact)",
        "specs/vrc/relationships/issue/0.1/spec.md:49-52"
      ],
      "clarify": null,
      "requires": [
        "carrier:consequential",
        "https://trusttasks.org/spec/vrc/relationships/issue/0.1",
        "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
        "optional:trigger.consent"
      ],
      "steps": [
        {
          "trigger": {
            "action": "policy",
            "args": {
              "propose": "accept"
            }
          }
        },
        {
          "send": {
            "template": "propose.request"
          },
          "capture": {
            "ibr": "/payload/relationshipDid"
          },
          "expect": {
            "disposition": "response",
            "type": "https://trusttasks.org/spec/vrc/relationships/propose/0.1#response",
            "match": {
              "/payload/relationshipDid": "^did:"
            },
            "state": {
              "handled": 1
            }
          }
        },
        {
          "send": {
            "template": "issue.request",
            "vrc": {}
          },
          "expect": {
            "disposition": "response",
            "type": "https://trusttasks.org/spec/vrc/relationships/issue/0.1#response",
            "pointer": {
              "/payload/vrcDigestMultibase": "$digest(vrc)",
              "/threadId": "$id(req)"
            },
            "state": {
              "handled": 2,
              "stored": 1
            }
          }
        }
      ]
    },
