    {
      "id": "VRC-ISS-003",
      "title": "a request digest that does not match the credential is not copied into the receipt",
      "tier": 1,
      "spec": [
        "specs/vrc/relationships/issue/0.1/spec.md:86-89 (a copied digest attests nothing about what was stored)",
        "specs/vrc/relationships/issue/0.1/spec.md:109"
