          },
          "expect": {
            "disposition": "next-step",
            "noSideEffect": true,
            "pointer": {
              "/threadId": "$id(req)",
              "/payload/expects/0/typeUri": "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
              "/payload/continuation": "resubmit",
              "/payload/inResponseTo/typeUri": "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
              "/payload/inResponseTo/id": "$id(req)"
            }
          }
        },
        {
          "trigger": {
            "action": "consent",
            "args": {
              "exchangeId": "$id(req)",
              "decision": "decline"
            }
          },
          "expect": {
            "disposition": "error",
            "code": "vrc/relationships/propose:declined",
            "retryable": false,
            "noSideEffect": true,
            "pointer": {
              "/threadId": "$id(req)"
            },
            "state": {
              "documentState": {
                "$id(req)": "errored"
              }
            }
          }
        }
      ]
    },
    {
      "id": "VRC-PRO-011",
      "title": "tier 1: an unsigned proposal is accepted (propose declares proof OPTIONAL)",
