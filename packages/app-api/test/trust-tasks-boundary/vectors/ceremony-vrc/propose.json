    {
      "id": "VRC-PRO-008",
      "title": "while the human decides the proposal is answered with a next-step that names a resubmission, never an error, a terminal reply or silence",
      "tier": 1,
      "spec": [
        "SPEC.md:1414 (8.6: a hold is a next step, never an error)",
        "SPEC.md:1416-1418 (expects names the originating Type URI with continuation resubmit where the consumer offers no status task)",
        "SPEC.md:682 (4.12 accepted row)",
        "specs/vrc/relationships/propose/0.1/spec.md:97-101 (acceptance is not issuance)",
        "specs/trust-task-next-step/0.1/payload.schema.json"
      ],
      "clarify": null,
      "requires": [
        "carrier:consequential",
        "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
        "optional:trigger.consent"
      ],
      "mutants": [
        "holdAnswersError",
        "holdAutoAccepts",
        "silentHold",
        "holdEmptyExpects",
        "holdExpectsOtherType",
        "holdContinuationProceed",
        "holdNextStepOpenPayload"
      ],
      "steps": [
        {
          "trigger": {
            "action": "policy",
            "args": {
              "propose": "hold"
            }
          }
        },
        {
          "send": {
            "template": "propose.request"
          },
          "expect": {
            "disposition": "next-step",
            "noSideEffect": true,
            "pointer": {
              "/threadId": "$id(req)",
              "/payload/expects/0/typeUri": "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
              "/payload/continuation": "resubmit",
              "/payload/inResponseTo/typeUri": "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
              "/payload/inResponseTo/id": "$id(req)"
            },
            "state": {
              "documentState": {
                "$id(req)": "accepted"
              }
            }
          }
        }
      ],
      "advisoryMutants": [
        "holdNoInResponseTo"
      ]
    },
    {
      "id": "VRC-PRO-009",
      "title": "a held proposal the human then accepts is answered with the acceptance on the proposal's thread",
      "tier": 1,
      "spec": [
        "specs/vrc/relationships/propose/0.1/spec.md:82-85",
        "SPEC.md:450-462 (4.9 threadId)",
        "SPEC.md:672-690 (4.12 lifecycle)"
      ],
      "clarify": "The vector expects the implementation to emit the acceptance on its own once the human decides; SPEC.md 8.6 requires the answer only when the producer next asks (a resubmission). A push is not stated. Not gating.",
      "requires": [
        "carrier:consequential",
        "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
        "optional:trigger.consent"
      ],
      "mutants": [
        "holdAutoAccepts"
      ],
      "steps": [
        {
          "trigger": {
            "action": "policy",
            "args": {
              "propose": "hold"
            }
          }
        },
        {
          "send": {
            "template": "propose.request"
          },
          "expect": {
            "disposition": "next-step",
            "noSideEffect": true,
            "pointer": {
              "/threadId": "$id(req)",
              "/payload/expects/0/typeUri": "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
              "/payload/continuation": "resubmit",
              "/payload/inResponseTo/typeUri": "https://trusttasks.org/spec/vrc/relationships/propose/0.1",
              "/payload/inResponseTo/id": "$id(req)"
            }
          }
        },
        {
          "trigger": {
            "action": "consent",
            "args": {
              "exchangeId": "$id(req)",
              "decision": "accept"
            }
          },
          "expect": {
            "disposition": "response",
            "type": "https://trusttasks.org/spec/vrc/relationships/propose/0.1#response",
            "pointer": {
              "/threadId": "$id(req)",
              "/payload/accept": true
            },
            "state": {
              "handled": 1,
              "documentState": {
                "$id(req)": "responded"
              }
            }
          }
        }
      ]
    },
