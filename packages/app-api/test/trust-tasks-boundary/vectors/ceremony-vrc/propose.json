    {
      "id": "VRC-PRO-001",
      "title": "an accepted proposal is answered with a #response: accept true and the counterparty's own relationshipDid",
      "tier": 1,
      "spec": [
        "specs/vrc/relationships/propose/0.1/spec.md:82-85 (counterparty items 1-2)",
        "specs/vrc/relationships/propose/0.1/spec.md:76-79 (proposer items 1-2)",
        "SPEC.md:1009-1015 (7.2 pipeline)"
