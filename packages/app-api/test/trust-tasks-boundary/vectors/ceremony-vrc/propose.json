    {
      "id": "VRC-PRO-018",
      "title": "a relationshipDid already recorded for another counterparty is refused",
      "tier": 1,
      "spec": [
        "specs/vrc/relationships/propose/0.1/spec.md:79",
        "specs credential: a pairwise identifier MUST NOT be used with more than one counterparty (CRED/body.md:381)",
        "docs/07 O26"
      ],
      "clarify": "The credential specification forbids using a pairwise identifier with a second counterparty; what the propose receiver must do on seeing one is not stated (docs/07 O26). Not gating.",
      "requires": [
        "carrier:consequential",
