      "tier": 1,
      "spec": [
        "framework 7.2 item 11 (Disposition of a duplicate)"
      ],
      "clarify": null,
      "mutants": [
        "noReplayRecord",
        "duplicateAsFailure"
      ],
      "steps": [
        {
          "send": {
            "template": "carrier.request"
          },
          "expect": {
            "disposition": "response",
            "state": {
              "handled": 1
            }
          }
        },
        {
          "at": "+5s",
          "send": {
            "same": "previous"
          },
          "expect": {
            "disposition": "duplicate",
            "state": {
              "handled": 1
            }
          }
        }
      ],
      "requires": [
        "carrier:consequential"
      ]
